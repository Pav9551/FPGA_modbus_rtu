module key_jitter (
    input      clk,
    input      rst_n,
    input      key_n,
    output reg key_valid
);

    reg [19:0] cnt0;
    reg [3:0]  key_down_check;

    reg key_valid_r0;
    reg key_valid_r1;
    reg key_valid_r2;

    wire key_valid_pos;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            cnt0 <= 20'd0;
        else
            cnt0 <= cnt0 + 1'b1;
    end

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            key_down_check <= 4'b0000;
        else if (cnt0 == 20'hFFFFF)
            key_down_check <= {key_down_check[2:0], ~key_n};
    end

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            key_valid_r0 <= 1'b0;
        else
            key_valid_r0 <= (key_down_check == 4'b0011);
    end

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n) begin
            key_valid_r1 <= 1'b0;
            key_valid_r2 <= 1'b0;
        end
        else begin
            key_valid_r1 <= key_valid_r0;
            key_valid_r2 <= key_valid_r1;
        end
    end

    assign key_valid_pos = !key_valid_r2 && key_valid_r1;

    always @(posedge clk or negedge rst_n) begin
        if (!rst_n)
            key_valid <= 1'b0;
        else
            key_valid <= key_valid_pos;
    end

endmodule